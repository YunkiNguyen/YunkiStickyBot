DISCORD_TOKEN=PASTE_TOKEN_IN_REPLIT_SECRETS

# Tuỳ chọn
# CLIENT_ID=            ID application của bot (mặc định lấy trong config.js)
# GUILD_ID=             CHỈ đặt khi test 1 server. Để trống = deploy Global (mọi server)
# BOT_OWNER_ID=         User ID được dùng /shutdown
# DATA_DIR=             Thư mục lưu dữ liệu JSON bền vững (mặc định ./data)
# CLEAR_GUILD_ID=       Chạy deploy 1 lần để xóa lệnh cũ của guild này (tránh lệnh bị trùng)
